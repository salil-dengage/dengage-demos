<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+. Asked for at runtime, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Geofence. Coarse and fine first; background is a SECOND, separate
         grant and is only requested behind an explicit control. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".NovaPayApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaPay">

        <!-- The Istanbul datacenter endpoints, confirmed in SETUP-MAC.md 4.5.
             These carry a tr- prefix while the web SDK on the same account
             posts to the unprefixed global aliases. Both are Istanbul. -->
        <meta-data android:name="den_event_api_url"    android:value="https://tr-event.dengage.com" />
        <meta-data android:name="den_push_api_url"     android:value="https://tr-push.dengage.com" />
        <meta-data android:name="den_geofence_api_url" android:value="https://tr-push.dengage.com/geoapi/" />
        <meta-data android:name="den_in_app_api_url"   android:value="https://tr-inapp.lib.dengage.com" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NovaPay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- novapay://<screen>. Every Screen constant is reachable as a URL
                 a campaign can target with no further work. Route table is in
                 MOBILE-SURFACES.md so a campaign author can read it. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="novapay" />
            </intent-filter>
        </activity>

        <!-- Paging control for the host-drawn carousel. -->
        <receiver
            android:name=".push.NovaPayCarousel$PageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dengagefintech.demo.CAROUSEL_PAGE" />
            </intent-filter>
        </receiver>

        <!-- ONLY our subclass is registered. Registering the SDK's service as
             well gives the device two services for one intent filter, and the
             one that wins is not deterministic. -->
        <service
            android:name=".push.NovaPayFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
