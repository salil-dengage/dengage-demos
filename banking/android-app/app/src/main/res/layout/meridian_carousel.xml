<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded body of a carousel notification.

  Wrapped by NotificationCompat.DecoratedCustomViewStyle, so the title, the
  body text, the app name, the timestamp and the theming are all supplied by
  the platform's own notification chrome. Only the parts the platform has no
  concept of live here: the image, the position label and the two arrows.

  Every view type used here is on the RemoteViews allow list. Do not add one
  that is not, and do not add a second full size ImageView: a notification
  crosses a Binder transaction capped at roughly 1MB and one image at a time
  is what keeps this comfortably inside it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/meridian_carousel_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/meridian_carousel_image_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">

        <ImageButton
            android:id="@+id/meridian_carousel_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@string/meridian_carousel_previous" />

        <TextView
            android:id="@+id/meridian_carousel_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

        <ImageButton
            android:id="@+id/meridian_carousel_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="@string/meridian_carousel_next" />
    </LinearLayout>
</LinearLayout>
